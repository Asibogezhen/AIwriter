# ============================================
# 墨笔 AI 爆款文章生成器 — 环境变量配置
# 复制此文件为 backend/.env 并填入你的 API 密钥
#   cp .env.example backend/.env
# ============================================

# 服务器
SERVER_PORT=8000
SERVER_HOST=0.0.0.0

# 数据库: postgres / sqlite（本地开发建议 sqlite）
DB_TYPE=postgres

# PostgreSQL（DB_TYPE=postgres 时需要）
DB_HOST=db
DB_PORT=5432
DB_NAME=ai_article
DB_USER=postgres
DB_PASSWORD=请输入你的数据库密码

# Redis（可选）
REDIS_HOST=redis
REDIS_PORT=6379

# JWT — 请务必修改为随机字符串
JWT_SECRET_KEY=请输入你的JWT密钥（随机字符串）

# DeepSeek AI — 必填
# 获取地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=请输入你的DeepSeek API密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云 DashScope（AI 生图，可选）
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=请输入你的DashScope API密钥

# Pexels 免费图库（可选）
# 获取地址: https://www.pexels.com/api/
PEXELS_API_KEY=请输入你的Pexels API密钥

# Tavily 搜索（可选）
# 获取地址: https://tavily.com/
TAVILY_API_KEY=请输入你的Tavily API密钥

# 图片存储目录
IMAGES_DIR=/data/images
